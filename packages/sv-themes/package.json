{
	"name": "sv-themes",
	"description": "SSR-safe Svelte 5 theme management library with advanced features like tab sync, FOUC prevention, scoped overrides, and more.",
	"version": "0.9.1",
	"author": "Nico Hosse <https://github.com/nicohosse>",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"theme",
		"ui",
		"ssr",
		"svelte",
		"runes",
		"theme-switcher",
		"svelte-5",
		"themes",
		"theme-manager",
		"fouc-mitigation",
		"typescript",
		"sveltekit",
		"library",
		"javascript",
		"frontend",
		"esm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nicohosse/sv-themes.git",
		"directory": "packages/sv-themes"
	},
	"scripts": {
		"build": "rimraf dist && svelte-package",
		"prepare": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run typecheck && biome check .",
		"prepack": "bun run build && publint",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.scss"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"default": "./dist/server.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./kit": {
			"types": "./dist/core/kit.d.ts",
			"svelte": "./dist/core/kit.js",
			"default": "./dist/core/kit.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "2.57.0",
		"@sveltejs/package": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.3.1",
		"@vitest/coverage-v8": "4.1.5",
		"@vitest/pretty-format": "4.1.5",
		"jsdom": "29.1.1",
		"publint": "0.3.18",
		"rimraf": "6.1.3",
		"svelte": "5.55.2",
		"svelte-check": "4.4.6",
		"typescript": "6.0.2",
		"vitest": "4.1.5"
	},
	"dependencies": {
		"esm-env": "1.2.2",
		"neverthrow": "8.2.0"
	}
}
