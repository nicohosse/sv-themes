{
	"name": "sv-themes",
	"description": "SSR-safe theme management for Svelte 5 and SvelteKit 3: request-isolated state, flash-free first paint, local and global theme scopes, OS preference mapping, cross-tab sync, and fully typed APIs.",
	"version": "0.9.4",
	"author": "Nico Hosse <https://github.com/nicohosse>",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"keywords": [
		"theme",
		"ui",
		"ssr",
		"svelte",
		"runes",
		"theme-switcher",
		"svelte-5",
		"themes",
		"theme-manager",
		"fouc-mitigation",
		"typescript",
		"sveltekit",
		"library",
		"javascript",
		"frontend",
		"esm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nicohosse/sv-themes.git",
		"directory": "packages/sv-themes"
	},
	"scripts": {
		"build": "rimraf dist && svelte-package",
		"prepare": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run typecheck && biome check .",
		"prepack": "bun run build && publint",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/tests",
		"!dist/**/tests/**",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.fixture.*"
	],
	"sideEffects": [
		"**/*.scss"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"default": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./kit": {
			"types": "./dist/core/kit.d.ts",
			"svelte": "./dist/core/kit.js",
			"default": "./dist/core/kit.js"
		},
		"./spa": {
			"types": "./dist/spa.d.ts",
			"svelte": "./dist/spa.js",
			"default": "./dist/spa.js"
		}
	},
	"typesVersions": {
		">4.0": {
			"./kit": [
				"./dist/core/kit.d.ts"
			],
			"./spa": [
				"./dist/spa.d.ts"
			]
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.1",
		"svelte": "^5.57.1"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/package": "3.0.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/pretty-format": "5.1.0",
		"jsdom": "31.0.1",
		"publint": "0.3.25",
		"rimraf": "6.1.4",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"esm-env": "1.2.2",
		"neverthrow": "8.2.0"
	}
}
