{
	"name": "sv-themes",
	"description": "SSR-safe Svelte theme switcher with tab sync and FOUC prevention.",
	"version": "0.1.0",
	"author": "Nico Hosse <https://github.com/Ventriix>",
	"keywords": [
		"svelte"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Ventriix/sv-themes",
		"directory": "packages/sv-themes"
	},
	"scripts": {
		"build": "svelte-package",
		"prepare": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run typecheck && biome check .",
		"prepack": "svelte-kit sync && svelte-package && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.scss"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"default": "./dist/server.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"svelte": "./dist/server.js",
			"default": "./dist/server.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"publint": "^0.3.18",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"esm-env": "^1.2.2",
		"neverthrow": "^8.2.0"
	}
}
