{
	"extends": "$app/tsconfig",
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "vitest.config.ts"],
	"exclude": ["node_modules", "dist", ".svelte-kit"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "@testing-library/jest-dom"]
	}
}
