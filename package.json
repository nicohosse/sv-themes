{
	"name": "root",
	"description": "Monorepo for sv-themes",
	"version": "0.0.0",
	"author": "Nico Hosse <https://github.com/nicohosse>",
	"license": "MIT",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nicohosse/sv-themes.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"prepare": "bun run --filter \"./packages/*\" prepare && lefthook install",
		"build": "bun run build:packages && bun run build:apps",
		"build:packages": "bun run --filter \"./packages/*\" build",
		"build:apps": "bun run --filter \"./apps/*\" build",
		"check": "bun run build:packages && bun run --filter \"./packages/*\" check && bun run --filter \"./apps/*\" check",
		"test": "bun run --filter \"./packages/*\" test",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "bun run build && npx changeset publish"
	},
	"engines": {
		"node": ">=22.17"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@changesets/cli": "3.0.3",
		"@socketsecurity/bun-security-scanner": "1.1.3",
		"@types/node": "26.6.6",
		"lefthook": "2.2.2",
		"prettier": "3.10.1",
		"stylelint": "18.0.0",
		"stylelint-config-idiomatic-order": "10.0.0",
		"stylelint-config-standard-scss": "18.0.0",
		"stylelint-scss": "7.5.0"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"lefthook"
	]
}
