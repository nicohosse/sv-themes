{
	"name": "demo",
	"description": "SvelteKit demo of sv-themes.",
	"version": "0.9.3",
	"author": "Nico Hosse <https://github.com/nicohosse>",
	"license": "MIT",
	"private": true,
	"keywords": [
		"svelte"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nicohosse/sv-themes.git",
		"directory": "apps/demo"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run typecheck && biome check ."
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/package": "3.0.2",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"publint": "0.3.25",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.2",
		"vite": "8.3.8"
	},
	"dependencies": {
		"sv-themes": "workspace:*"
	}
}
